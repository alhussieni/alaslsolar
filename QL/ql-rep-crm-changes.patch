+function normalizePhone(raw) {
+  let d = String(raw || "").replace(/\D/g, "");
+  if (d.startsWith("0020")) d = d.slice(4);
+  if (d.startsWith("20") && d.length > 10) d = d.slice(2);
+  if (d.startsWith("0") && d.length > 10) d = d.slice(1);
+  if (d.startsWith("0")) d = d.slice(1);
+  return d;
+}
