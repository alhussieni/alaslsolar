e":"RSM132-8-720-745BHDG","description":"The Hyper-ion Pro flagship — heterojunction cell technology at up to 745 W and 24.0% efficiency, with at least 90% of rated output still guaranteed at year 30.","category":"Solar panel","brand":{"@type":"Brand","name":"Risen Energy"},"manufacturer":{"@type":"Organization","name":"Risen Energy Australia","url":"https://risenenergy.com.au"},"image":"https://risenenergy.com.au/_astro/front.x1BH5SMS.png"}</script><script async src="https://www.googletagmanager.com/gtag/js?id=G-72LEHQQBSS"></script><script>(function(){const gtagIds = ["G-72LEHQQBSS","AW-18297553556"];

          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          // The invite-only EOI page is reached as ?invite=<single-use token>. gtag's
          // automatic page_view reports page_location (the full URL) AND page_referrer
          // (document.referrer, which becomes the invite URL once the visitor clicks
          // through to another page) — either would ship the token (and, via the gated
          // GET, the invitee's email) to Google Analytics / Ads. Strip invite/token
          // from BOTH. Fail closed: if a URL can't be parsed, drop its whole query
          // string rather than risk leaking the token.
          function stripSensitive(raw) {
            try {
              var u = new URL(raw);
              ['invite', 'token'].forEach(function (p) { u.searchParams.delete(p); });
              return u.toString();
            } catch (e) { return String(raw).split('?')[0]; }
          }
          var cfg = { page_location: stripSensitive(location.href) };
          if (document.referrer) cfg.page_referrer = stripSensitive(document.referrer);
          gtagIds.forEach(function (id) { gtag('config', id, cfg); });
        })();</script><link rel="stylesheet" href="/_astro/Base.BuxwT6d5.css">
